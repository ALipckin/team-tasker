COMPOSE_PROJECT_NAME=team-tasker

APP_PORT=8080
TZ=UTC
LOG_LEVEL=info

DB_USER=app
DB_PASSWORD=app
DB_ROOT_PASSWORD=root
DB_DATABASE=tasks
DB_EXPOSE_PORT=3306

REDIS_PASSWORD=
REDIS_DB=0
REDIS_EXPOSE_PORT=6379

JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL=24h

TASKS_CACHE_TTL=5m
RATE_LIMIT_RPS=20
RATE_LIMIT_BURST=40
# CIDR прокси через запятую, которым доверяем X-Forwarded-For — только точные адреса
# обратного прокси (например, 10.0.0.5/32). Не указывайте широкие сети вроде 172.16.0.0/12:
# в них входят шлюзы Docker, и клиент сможет подделать свой IP через X-Forwarded-For.
TRUSTED_PROXIES=

DLV_PORT=40000
