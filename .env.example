COMPOSE_PROJECT_NAME=task-service

APP_PORT=8080
TZ=UTC
LOG_LEVEL=info

DB_USER=app
DB_PASSWORD=app
DB_ROOT_PASSWORD=root
DB_DATABASE=tasks
DB_EXPOSE_PORT=3306

REDIS_PASSWORD=
REDIS_DB=0
REDIS_EXPOSE_PORT=6379

JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL=24h

TASKS_CACHE_TTL=5m
RATE_LIMIT_RPS=20
RATE_LIMIT_BURST=40

DLV_PORT=40000
